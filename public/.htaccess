# ===== Adresses « propres » (référencement) =====
# annonce/12-velo, categorie/3-vetements, le-concept, sitemap.xml… sont envoyées à index.php,
# qui retrouve la bonne page (voir app/core/UrlPropre.php). Les fichiers qui existent (css, images…) sont servis normalement.
# Si le module mod_rewrite n'est pas actif, le site garde les adresses index.php?route=… et fonctionne quand même.
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Une seule adresse pour Google : www.visota.fr → visota.fr (sinon le site existe « en double »)
    RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
    RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
    # Prévient PHP que la réécriture marche : url() fabrique alors des adresses propres
    RewriteRule ^ - [E=URLS_PROPRES:1]
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.php [QSA,L]
</IfModule>

# ===== Optimisations (ignorées sans risque si le module Apache n'est pas actif) =====

# Compression gzip du HTML, CSS, JS, SVG : 3 à 5× moins de données à télécharger
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/json
</IfModule>

# Cache navigateur : les images, le CSS et le JS ne sont pas retéléchargés à chaque page
# (le CSS est appelé avec ?v=date-de-modification, donc une nouvelle version est quand même prise)
<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/jpeg "access plus 1 month"
    ExpiresByType image/png "access plus 1 month"
    ExpiresByType image/webp "access plus 1 month"
    ExpiresByType image/svg+xml "access plus 1 month"
    ExpiresByType text/css "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 week"
    ExpiresByType text/javascript "access plus 1 week"
</IfModule>

# Sécurité : le navigateur ne doit pas « deviner » le type d'un fichier, et le site ne peut pas être mis dans une iframe
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# Sécurité : fichiers techniques jamais accessibles depuis le navigateur (journal d'erreurs PHP, sauvegardes…)
<FilesMatch "(^error_log|\.(log|sql|md|sh|bak|ini))$">
    Require all denied
</FilesMatch>

# ===== Taille des photos envoyées =====
# PHP refuse les fichiers trop lourds avant même que le site les voie : 10 Mo par photo, 64 Mo par envoi (5 photos max).
# Ces lignes servent sous MAMP (PHP intégré à Apache). Chez o2switch elles sont ignorées :
# on règle les mêmes valeurs dans cPanel → Sélectionner une version de PHP → Options.
<IfModule mod_php.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>
<IfModule mod_php7.c>
    php_value upload_max_filesize 10M
    php_value post_max_size 64M
    php_value memory_limit 256M
</IfModule>

# ===== Décodeur des photos iPhone (HEIC) =====
# Le navigateur charge js/vendor/libheif/libheif.wasm : il faut le bon type de fichier
<IfModule mod_mime.c>
    AddType application/wasm .wasm
</IfModule>
